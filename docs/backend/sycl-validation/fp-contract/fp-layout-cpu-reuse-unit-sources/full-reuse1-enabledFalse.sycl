    h.parallel_for(sycl::nd_range<3>(sycl::range<3>(gridX, gridY, gridZ) * sycl::range<3>(blockX, blockY, blockZ), sycl::range<3>(blockX, blockY, blockZ)), [=](sycl::nd_item<3> item) {
      padding_layout(item, var_0, var_1, var_2, var_3, var_4, var_5, var_6, var_7);
    });
  });
}

extern "C" void profile_padding_layout(sycl::queue* q, size_t gridX, size_t gridY, size_t gridZ, size_t blockX, size_t blockY, size_t blockZ, triton_sycl_float16* var_0, triton_sycl_float16* var_1, float* var_2, triton_sycl_float16* var_3, int64_t var_4, uint64_t* elapsed_ns) {
  auto device = q->get_device();
  if (20480ULL > device.get_info<sycl::info::device::local_mem_size>()) throw std::runtime_error("SYCL kernel local-memory requirement exceeds device limit: 20480 bytes");
  auto max_group = device.get_info<sycl::info::device::max_work_group_size>();
  auto max_axis = device.get_info<sycl::info::device::max_work_item_sizes<3>>();
  if (!blockX || !blockY || !blockZ || blockX > max_axis[0] || blockY > max_axis[1] || blockZ > max_axis[2] || blockX > max_group/blockY || blockX*blockY > max_group/blockZ) throw std::runtime_error("SYCL local range exceeds device limit");
  sycl::event kernel_event = q->submit([&](sycl::handler &h) {
    sycl::local_accessor<triton_sycl_float16, 2> var_5(sycl::range<2>(32, 64), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_6(sycl::range<2>(64, 64), h);
    sycl::local_accessor<float, 2> var_7(sycl::range<2>(32, 64), h);
    h.parallel_for(sycl::nd_range<3>(sycl::range<3>(gridX, gridY, gridZ) * sycl::range<3>(blockX, blockY, blockZ), sycl::range<3>(blockX, blockY, blockZ)), [=](sycl::nd_item<3> item) {
      padding_layout(item, var_0, var_1, var_2, var_3, var_4, var_5, var_6, var_7);
    });
  });
  kernel_event.wait_and_throw();
  *elapsed_ns = kernel_event.get_profiling_info<sycl::info::event_profiling::command_end>() - kernel_event.get_profiling_info<sycl::info::event_profiling::command_start>();
}

