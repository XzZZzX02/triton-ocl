  if (!blockX || !blockY || !blockZ || blockX > max_axis[0] || blockY > max_axis[1] || blockZ > max_axis[2] || blockX > max_group/blockY || blockX*blockY > max_group/blockZ) throw std::runtime_error("SYCL local range exceeds device limit");
  q->submit([&](sycl::handler &h) {
    sycl::local_accessor<float, 2> var_6(sycl::range<2>(32, 16), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_7(sycl::range<2>(64, 32), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_8(sycl::range<2>(32, 64), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_9(sycl::range<2>(64, 16), h);
    h.parallel_for(sycl::nd_range<3>(sycl::range<3>(gridX, gridY, gridZ) * sycl::range<3>(blockX, blockY, blockZ), sycl::range<3>(blockX, blockY, blockZ)), [=](sycl::nd_item<3> item) {
      kernel(item, var_0, var_1, var_2, var_3, var_4, var_5, var_6, var_7, var_8, var_9);
    });
  });
}

extern "C" void profile_kernel(sycl::queue* q, size_t gridX, size_t gridY, size_t gridZ, size_t blockX, size_t blockY, size_t blockZ, triton_sycl_float16* var_0, triton_sycl_float16* var_1, float* var_2, int32_t var_3, int32_t var_4, int32_t var_5, uint64_t* elapsed_ns) {
  auto device = q->get_device();
  if (12288ULL > device.get_info<sycl::info::device::local_mem_size>()) throw std::runtime_error("SYCL kernel local-memory requirement exceeds device limit: 12288 bytes");
  auto max_group = device.get_info<sycl::info::device::max_work_group_size>();
  auto max_axis = device.get_info<sycl::info::device::max_work_item_sizes<3>>();
  if (!blockX || !blockY || !blockZ || blockX > max_axis[0] || blockY > max_axis[1] || blockZ > max_axis[2] || blockX > max_group/blockY || blockX*blockY > max_group/blockZ) throw std::runtime_error("SYCL local range exceeds device limit");
  sycl::event kernel_event = q->submit([&](sycl::handler &h) {
    sycl::local_accessor<float, 2> var_6(sycl::range<2>(32, 16), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_7(sycl::range<2>(64, 32), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_8(sycl::range<2>(32, 64), h);
    sycl::local_accessor<triton_sycl_float16, 2> var_9(sycl::range<2>(64, 16), h);
    h.parallel_for(sycl::nd_range<3>(sycl::range<3>(gridX, gridY, gridZ) * sycl::range<3>(blockX, blockY, blockZ), sycl::range<3>(blockX, blockY, blockZ)), [=](sycl::nd_item<3> item) {
      kernel(item, var_0, var_1, var_2, var_3, var_4, var_5, var_6, var_7, var_8, var_9);
    });
  });
  kernel_event.wait_and_throw();
  *elapsed_ns = kernel_event.get_profiling_info<sycl::info::event_profiling::command_end>() - kernel_event.get_profiling_info<sycl::info::event_profiling::command_start>();
}

